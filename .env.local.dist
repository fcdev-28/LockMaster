# Plantilla de .env.local, el fichero con los secretos de desarrollo.
#
#   cp .env.local.dist .env.local
#
# Tal cual funciona para desarrollo local. Si quieres valores propios:
#
#   openssl rand -hex 32
#
# .env.local no se versiona (.gitignore). Los valores de .env son placeholders
# y los de aquí mandan sobre ellos.

APP_SECRET=cambia-esta-clave
JWT_PASSPHRASE=cambia-esta-passphrase

# Credenciales de MySQL. Las MYSQL_* las usa el contenedor db al inicializar el
# volumen; DATABASE_URL y DB_* las usa la app. La contraseña sale en las tres:
# si la cambias, cámbiala en las tres y recrea el volumen (docker compose down -v).
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-de-root
MYSQL_DATABASE=lockmaster
MYSQL_USER=lockmaster
MYSQL_PASSWORD=cambia-esta-contrasena

DATABASE_URL="mysql://lockmaster:cambia-esta-contrasena@db:3306/lockmaster?serverVersion=8.0&charset=utf8mb4"
DB_HOST=db
DB_USER=lockmaster
DB_PASSWORD=cambia-esta-contrasena
