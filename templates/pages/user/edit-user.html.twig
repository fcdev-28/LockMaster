{% extends 'base.html.twig' %}

{% block title %}
    {% if user.id is null %}
        Create
    {% else %}
        Edit
    {% endif %}
    user - LockMaster
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('forms') }}
    {{ encore_entry_link_tags('edit-user') }}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('forms') }}
    {{ encore_entry_script_tags('edit-user') }}
{% endblock %}

{% block navbar %}
    <nav class="navbar">
        <div class="nav-container">
            <a href="{{ path('index') }}" class="logo">LockMaster</a>
            <div class="menu">
                <label for="menu-checkbox"><span class="icon-th-menu"></span></label>
                <input type="checkbox" id="menu-checkbox">

                <div class="nav-links">
                    <a href="{% if is_granted('ROLE_ADMIN') %} {{ path('user_list')}} {% else %} {{ path('account')}} {% endif %}" class="nav-link"><span class="icon-rewind"></span>Back</a>
                </div>
            </div>
        </div>
    </nav>
{% endblock %}

{% block body %}
    <div class="content">
        <div class="user-data">
            {% if user.id is null %}
                <h1>Create User</h1>
            {% else %}
                <h1>Edit User</h1>
            {% endif %}

            <div class="user">
                <div class="avatar">
                    {% if user.id is null %}
                        <h2>No avatar found</h2>
                    {% else %}
                        <img src="{{ user.getPhotoAsBase64 }}" alt="Foto de perfil" style="max-width:150px; max-height:150px;">
                    {% endif %}
                </div>
            </div>

            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.uploadedPhoto) }}
                    {{ form_errors(form.uploadedPhoto) }}
                    {{ form_widget(form.uploadedPhoto) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.birthDate) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.phoneNumber) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.username) }}
                </div>

                <div class="buttons">
                    <button type="submit">Submit</button>
                    <a href="{% if is_granted('ROLE_ADMIN') %} {{ path('user_list')}} {% else %} {{ path('account')}} {% endif %}">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}