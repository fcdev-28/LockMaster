{% extends 'base.html.twig' %}

{% block title %}Delete Restriction - LockMaster{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('confirm-delete') }}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('confirm-delete') }}
{% endblock %}

{% block navbar %}
    <nav class="navbar">
        <div class="nav-container">
            <a href="{{ path('index') }}" class="logo">LockMaster</a>
        </div>
    </nav>
{% endblock %}

{% block body %}
    <div class="content">
        <h1>Are you sure you want to delete the history?</h1>

        <form method="post">
            <div class="buttons">
                <button type="submit" name="confirm">Confirm</button>
                <a href="{{ path('access_log') }}">Cancel</a>
            </div>
        </form>
    </div>
{% endblock %}