{% extends 'base.html.twig' %}

{% block title %}
    {% if group.id is null %}
        Create
    {% else %}
        Edit
    {% endif %}
    User Group - LockMaster
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('forms') }}
    {{ encore_entry_link_tags('edit-group') }}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('forms') }}
    {{ encore_entry_script_tags('edit-group') }}
{% endblock %}

{% block navbar %}
    <nav class="navbar">
        <div class="nav-container">
            <a href="{{ path('index') }}" class="logo">LockMaster</a>
            <div class="menu">
                <label for="menu-checkbox"><span class="icon-th-menu"></span></label>
                <input type="checkbox" id="menu-checkbox">

                <div class="nav-links">
                    <a href="{{ path('user_group_list') }}" class="nav-link"><span class="icon-rewind"></span>Back</a>
                </div>
            </div>
        </div>
    </nav>
{% endblock %}

{% block body %}
    <div class="content">
        {{ form_start(form) }}

        {{ form_errors(form) }}
        <div class="group-data">
            <h1>{% if group is not null %}
                    Edit
                {% else %}
                    Create
                {% endif %} User Group</h1>

                <div class="form-group">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                </div>

                <div class="data">
                    {{ form_label(form.users) }}
                    <div class="select-container">
                        {% for user in form.users %}
                            <div class="user">
                                {{ form_widget(user) }}
                                {{ form_label(user) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="buttons">
                    <button type="submit">Submit</button>
                    <a href="{{ path('user_group_list') }}">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}