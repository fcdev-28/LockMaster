{% extends 'base.html.twig' %}

{% block title %}Change password - LockMaster{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('forms') }}
    {{ encore_entry_link_tags('edit-password') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('forms') }}
    {{ encore_entry_script_tags('edit-password') }}
{% endblock %}

{% block navbar %}
    <nav class="navbar">
        <div class="nav-container">
            <a href="{{ path('index') }}" class="logo">LockMaster</a>
            <div class="menu">
                <label for="menu-checkbox"><span class="icon-th-menu"></span></label>
                <input type="checkbox" id="menu-checkbox">

                <div class="nav-links">
                    <a href="{% if is_granted('ROLE_ADMIN') %} {{ path('user_list')}} {% else %} {{ path('account')}} {% endif %}" class="nav-link"><span class="icon-rewind"></span>Back</a>
                </div>
            </div>
        </div>
    </nav>
{% endblock %}

{% block body %}
    <div class="content">
        <div class="form-container">
            <div class="title">
                <h1>Change password</h1>
                <h3>{{ app.user.username }}</h3>
            </div>

            {{ form_start(form) }}
                {{  form_row(form.oldPassword) }}

                <div class="form-row">
                    {{ form_row(form.newPassword) }}
                </div>

                <div class="buttons">
                    <button type="submit">Confirm</button>
                    <a href="{% if is_granted('ROLE_ADMIN') %} {{ path('user_list')}} {% else %} {{ path('account')}} {% endif %}">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}